<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.novel.mapper.NovelChapterMapper">

    <resultMap id="BaseResultMap" type="com.novel.domain.po.NovelChapter">
            <id property="id" column="id" />
            <result property="novelId" column="novel_id" />
            <result property="chapterNo" column="chapter_no" />
            <result property="title" column="title" />
            <result property="content" column="content" />
            <result property="wordCount" column="word_count" />
            <result property="status" column="status" />
            <result property="createdAt" column="created_at" />
            <result property="updatedAt" column="updated_at" />
    </resultMap>

    <sql id="Base_Column_List">
        id,novel_id,chapter_no,title,content,word_count,
        status,created_at,updated_at
    </sql>
</mapper>
